      margin: 0;
      min-width: 0;
      min-height: 0;
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .figure-wide-media {
      flex: 1 1 auto;
      min-height: 0;
      min-width: 0;
      width: 100%;
      max-height: 100%;
      align-self: stretch;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .figure-wide-media .diagram-container {
      flex: 1 1 auto;
      min-height: 0;
      min-width: 0;
      width: 100%;
      max-height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      overflow: auto;
    }
    .figure-wide-media .diagram-container pre.mermaid {
      max-width: 100%;
      max-height: 100%;
    }
    /* figure-wide: apply figure_scale like layout: figure --fill (zoom / transform).
       Do not use calc(100% * scale) on img max-height — percentage base is often
       indefinite, so the rule is dropped and scale appears to do nothing. */
    .figure-wide-figure > .figure-wide-media > img,
    .figure-wide-media img {
      flex: 0 1 auto;
      max-width: 100%;
      max-height: 417.6px;
      width: auto;
      height: auto;
      object-fit: contain;
      margin: 0 auto;
      display: block;
      transform: scale(var(--figure-scale, 1));
      transform-origin: center center;
    }
    .figure-wide-media .diagram-container svg,
    .slide-figure-wide .figure-wide-media .diagram-container svg {
      max-width: 100%;
      max-height: 417.6px;
      width: auto;
      height: auto;
      object-fit: contain;
      display: block;
      margin: 0 auto;
      transform: scale(var(--figure-scale, 1));
      transform-origin: center center;
    }
    @supports (zoom: 1) {
      .slide-figure-wide .figure-wide-media > img,
      .slide-figure-wide .figure-wide-media img {
        max-height: 417.6px;
        transform: none;
        transform-origin: unset;
        zoom: var(--figure-scale, 1);
      }
      .slide-figure-wide .figure-wide-media .diagram-container svg {
        max-width: 100%;
        max-height: 417.6px;
        transform: none;
        transform-origin: unset;
        zoom: var(--figure-scale, 1);
      }
    }
    .figure-wide-below {
      flex: 0 0 auto;
    }
    .figure-wide-columns {
      align-items: start;
    }
    .figure-wide-columns .col-left,
    .figure-wide-columns .col-right {
      min-width: 0;
    }
    .figure-wide-columns h3,
    .figure-wide-single-col h3 {
      color: var(--accent);
      margin-bottom: 0.4rem;
    }
    .figure-wide-single-col {
      width: 100%;
    }
    .slide-figure-wide figcaption {
      flex: 0 0 auto;
      margin-top: 0.75rem;
      text-align: left;
    }
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <main id="main-content" role="region" aria-roledescription="carousel" aria-label="{{ deck.metadata.title | e }}"{% if deck.metadata.flavor == 'transcript' %} class="deck-flavor-transcript"{% endif %}>
    <div id="deck-app-root">
    {% for s in slides %}
    {% set slide = s.slide %}
    {% set slide_id = s.slide_id %}
    {% set rendered_title = s.rendered_title %}
    {% set rendered_subtitle = s.rendered_subtitle %}
    {% set rendered_author_line = s.rendered_author_line %}
    {% set rendered_body = s.rendered_body %}
    {% set rendered_table_headers = s.rendered_table_headers %}
    {% set rendered_table_rows = s.rendered_table_rows %}
    {% set rendered_table_caption = s.rendered_table_caption %}
    {% set rendered_description = s.rendered_description %}
    {% set rendered_code = s.rendered_code %}
    {% set rendered_image = s.rendered_image %}
    {% set rendered_svg = s.rendered_svg %}
    {% set rendered_mermaid = s.rendered_mermaid %}
    {% set mermaid_data_attrs = s.mermaid_data_attrs %}
    {% set rendered_left_col = s.rendered_left_col %}
    {% set rendered_right_col = s.rendered_right_col %}
    {% set rendered_fw_summary = s.rendered_fw_summary %}
    {% set rendered_fw_left_heading = s.rendered_fw_left_heading %}
    {% set rendered_fw_left_body = s.rendered_fw_left_body %}
    {% set rendered_fw_right_heading = s.rendered_fw_right_heading %}
    {% set rendered_fw_right_body = s.rendered_fw_right_body %}
    {% set title_has_math = s.title_has_math %}
    {% set extra_class = '' %}
    {% if slide.layout == 'figure' and not slide.body %}{% set extra_class = ' figure-only' %}{% endif %}
    {% if slide.layout == 'diagram' and not slide.body %}{% set extra_class = ' diagram-only' %}{% endif %}
    {% if title_has_math %}{% set extra_class = extra_class ~ ' slide-heading-math' %}{% endif %}
    {% if s.math_display_center|default(true) %}{% set extra_class = extra_class ~ ' math-display-eq-center' %}{% else %}{% set extra_class = extra_class ~ ' math-display-eq-start' %}{% endif %}
    <section id="{{ slide_id }}" role="group" class="slide-{{ slide.layout }}{{ extra_class }}"{% if s.bullet_stagger_json %} data-bullet-stagger="{{ s.bullet_stagger_json | e }}"{% endif %}{% if s.bullet_focus_json %} data-bullet-focus="{{ s.bullet_focus_json | e }}"{% endif %} style="--title-scale: {{ s.title_scale }}; --content-scale: {{ s.content_scale }}; --math-display-scale: {{ s.math_display_scale }};{% if s.math_display_color %} --math-display-color: {{ s.math_display_color | e }};{% endif %}{% if slide.layout in ['figure', 'figure-wide'] and s.figure_scale is not none %} --figure-scale: {{ s.figure_scale }};{% endif %}{% if s.panel_scale_x is not none %} --panel-scale-x: {{ s.panel_scale_x }}; --panel-scale-y: {{ s.panel_scale_y }};{% endif %}" aria-roledescription="slide" aria-label="Slide {{ loop.index }} of {{ total }}" aria-labelledby="{{ slide_id }}-heading">
      {% include slide.layout ~ '.html.j2' %}
    </section>
    {% endfor %}
    </div>
    <nav id="slide-footer-nav" class="slide-footer-nav" aria-label="Slide position, view scale, and go to slide">
      <span class="deck-view-scale-cluster" role="group" aria-label="View scale">
        <button type="button" id="deck-view-zoom-out" class="deck-view-scale-btn" title="Zoom out (keyboard −)" aria-keyshortcuts="-">−</button>
        <span id="deck-view-scale-pct" aria-live="polite">100%</span>
        <button type="button" id="deck-view-zoom-in" class="deck-view-scale-btn" title="Zoom in (keyboard + or =)" aria-keyshortcuts="+ Shift+=">+</button>
        <button type="button" id="deck-view-zoom-reset" class="deck-view-scale-btn" title="Reset view scale (keyboard 0)" aria-keyshortcuts="0">↺</button>
      </span>
      <span id="slide-counter" aria-live="polite" aria-atomic="true">1 / {{ total }}</span>
      <form id="slide-goto-form" class="slide-goto-form" hidden>
        <label for="slide-goto-input" class="visually-hidden">Go to slide number (1 to {{ total }})</label>
        <input id="slide-goto-input" class="slide-goto-input" type="number" min="1" max="{{ total }}" step="1" inputmode="numeric" autocomplete="off" aria-label="Slide number, then press Enter" />
      </form>
      <button type="button" id="slide-goto-open" class="slide-goto-open" aria-expanded="false" aria-controls="slide-goto-form" title="Go to slide (keyboard: G)">#</button>
    </nav>
    <div id="deck-hud" aria-hidden="true"></div>
  </main>
  <script>
  (function() {
    var deckRoot = document.getElementById('deck-app-root');
    var slides = Array.from(document.querySelectorAll('#deck-app-root [role="group"]'));
    var clip = document.getElementById('main-content');
    var hud = document.getElementById('deck-hud');
    var CW = 1280, CH = 720;
    var idx = 0;
    var counter = document.getElementById('slide-counter');
    var gotoForm = document.getElementById('slide-goto-form');
    var gotoInput = document.getElementById('slide-goto-input');
    var gotoOpen = document.getElementById('slide-goto-open');
    var zoomOutBtn = document.getElementById('deck-view-zoom-out');
    var zoomInBtn = document.getElementById('deck-view-zoom-in');
    var zoomResetBtn = document.getElementById('deck-view-zoom-reset');
    var scalePctEl = document.getElementById('deck-view-scale-pct');

    var htmlEl = document.documentElement;
    var defaultViewScale = parseFloat(htmlEl.getAttribute('data-deck-default-view-scale') || '1', 10);
    if (!isFinite(defaultViewScale) || defaultViewScale <= 0) defaultViewScale = 1;
    var rememberViewScale = htmlEl.getAttribute('data-deck-remember-view-scale') === 'true';
    var VIEW_SCALE_LS = 'mdToYamlDeckViewScale';
    var VIEW_SCALE_MIN = 0.25;
    var VIEW_SCALE_MAX = 4;
    var VIEW_SCALE_STEP = 1.1;

    function clampViewScale(x) {
      return Math.max(VIEW_SCALE_MIN, Math.min(VIEW_SCALE_MAX, x));
    }

    function parseViewScaleParam(raw) {
      if (raw == null || raw === '') return null;
      var s = String(raw).trim();
      if (s.endsWith('%')) {
        var n = parseFloat(s.slice(0, -1), 10);
        return isFinite(n) ? n / 100 : null;
      }
      var f = parseFloat(s, 10);
      return isFinite(f) ? f : null;
    }

    function readInitialViewScale() {
      var params = new URLSearchParams(window.location.search);
      var fromUrl = parseViewScaleParam(params.get('viewScale'));
      if (fromUrl != null) return clampViewScale(fromUrl);
      if (rememberViewScale) {
        try {
          var st = localStorage.getItem(VIEW_SCALE_LS);
          if (st != null) {
            var v = parseFloat(st, 10);
            if (isFinite(v)) return clampViewScale(v);
          }
        } catch (err) {}
      }
      return clampViewScale(defaultViewScale);
    }

    var viewScale = readInitialViewScale();

    function persistViewScale() {
      if (!rememberViewScale) return;
      try {
        localStorage.setItem(VIEW_SCALE_LS, String(viewScale));
      } catch (err) {}
    }

    function formatScalePct(x) {
      return Math.round(x * 100) + '%';
    }



    function requestMermaidResize() {
      try {
        var fn = window.__mdToYamlSizeAllMermaidSvgs;
        if (typeof fn !== 'function') return;
        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            fn();
          });
        });
      } catch (err) {}
    }
    // fit(): the single scaling principle, identical on every device. Measure
    // the CLIPPING element (correct on iOS even mid-toolbar-animation — never
    // window.innerHeight) and scale the stage about its arithmetic-pinned
    // center. viewScale is the user's +/-/0 multiplier on top of the fit.
    function fit() {
      var r = clip.getBoundingClientRect();
      var s = Math.min(r.width / CW, r.height / CH) * viewScale;
      deckRoot.style.setProperty('--deck-fit-scale', String(s));
      if (scalePctEl) scalePctEl.textContent = formatScalePct(viewScale);
      // #debug HUD (from migrate_deck.py): append #debug to the URL and every
      // number the browser reports is overlaid — turns "looks wrong on my
      // phone" into exact figures.
      if (hud && location.hash.indexOf('debug') !== -1) {
        hud.style.display = 'block';
        var vv = window.visualViewport;
        hud.textContent = [
          'clip     : ' + r.width.toFixed(1) + ' x ' + r.height.toFixed(1),
          'inner    : ' + window.innerWidth + ' x ' + window.innerHeight,
          (vv ? 'visualVP : ' + vv.width.toFixed(1) + ' x ' + vv.height.toFixed(1) +
                '  scale ' + vv.scale.toFixed(2) +
                '  offset ' + vv.offsetLeft.toFixed(0) + ',' + vv.offsetTop.toFixed(0)
              : 'visualVP : n/a'),
          'fit scale: ' + s.toFixed(4),
          'slide    : ' + (idx + 1) + '/' + slides.length
        ].join(String.fromCharCode(10));
        var bad = auditBounds();
        hud.textContent += String.fromCharCode(10) + 'bounds   : ' + bad.length + ' offender(s)';
        if (bad.length) console.table(bad);
      }
    }

    function applyViewScale(next) {
      viewScale = clampViewScale(next);
      persistViewScale();
      fit();
      requestMermaidResize();
    }

    applyViewScale(viewScale);

    function bumpViewScale(factor) {
      applyViewScale(viewScale * factor);
    }

    if (zoomOutBtn) zoomOutBtn.addEventListener('click', function() { bumpViewScale(1 / VIEW_SCALE_STEP); });
    if (zoomInBtn) zoomInBtn.addEventListener('click', function() { bumpViewScale(VIEW_SCALE_STEP); });
    if (zoomResetBtn) zoomResetBtn.addEventListener('click', function() { applyViewScale(defaultViewScale); });

    function isTypingInField(el) {
      if (!el || !el.tagName) return false;
      var tag = el.tagName.toLowerCase();
      if (tag === 'textarea') return true;
      if (tag === 'input') {
        var t = (el.type || '').toLowerCase();
        if (t === 'button' || t === 'submit' || t === 'checkbox' || t === 'radio') return false;
        return true;
      }
      return el.isContentEditable;
    }

    function openGoto() {
      gotoForm.hidden = false;
      gotoOpen.hidden = true;
      gotoOpen.setAttribute('aria-expanded', 'true');
      gotoInput.value = String(idx + 1);
      gotoInput.focus();
      gotoInput.select();
    }

    function closeGoto() {
      gotoForm.hidden = true;
      gotoOpen.hidden = false;
      gotoOpen.setAttribute('aria-expanded', 'false');
    }

    function submitGoto() {
      var n = parseInt(gotoInput.value, 10);
      if (!isFinite(n)) return;
      n = Math.max(1, Math.min(slides.length, n));
      goTo(n - 1);
      closeGoto();
    }

    // Discrete slides: show one layer at a time. No scrolling, no
    // IntersectionObserver — idx is the single source of truth.
    function show(n) {
      idx = Math.max(0, Math.min(n, slides.length - 1));
      slides.forEach(function(el, i) { el.classList.toggle('active', i === idx); });
      counter.textContent = (idx + 1) + ' / ' + slides.length;
      var s = slides[idx];
      if (!s.hasAttribute('tabindex')) s.setAttribute('tabindex', '-1');
      try { s.focus({ preventScroll: true }); } catch (err) {}
      fit();
    }
    function goTo(n) { show(n); }

    // Touch: horizontal swipe advances/retreats; vertical-dominant gestures
    // are ignored so scrolling a dense slide still works (migrate_deck.py).
    var tx = null, ty = null;
    clip.addEventListener('touchstart', function(e) {
      var t = e.changedTouches[0]; tx = t.clientX; ty = t.clientY;
    }, { passive: true });
    clip.addEventListener('touchend', function(e) {
      if (tx === null) return;
      var t = e.changedTouches[0], dx = t.clientX - tx, dy = t.clientY - ty;
      tx = ty = null;
      if (Math.abs(dx) > 50 && Math.abs(dx) > 1.5 * Math.abs(dy)) show(idx + (dx < 0 ? 1 : -1));
    }, { passive: true });

    gotoOpen.addEventListener('click', function() { openGoto(); });

    gotoForm.addEventListener('submit', function(e) {
      e.preventDefault();
      submitGoto();
    });

    gotoInput.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        e.preventDefault();
        closeGoto();
        gotoOpen.focus();
      }
    });

    gotoInput.addEventListener('blur', function() {
      window.setTimeout(function() {
        if (document.activeElement === gotoInput) return;
        if (!gotoForm.hidden) closeGoto();
      }, 120);
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'g' || e.key === 'G') {
        if (e.ctrlKey || e.metaKey || e.altKey) return;
        if (e.repeat) return;
        if (isTypingInField(e.target) && e.target !== gotoInput) return;
        e.preventDefault();
        if (!gotoForm.hidden) {
          closeGoto();
          return;
        }
        openGoto();
        return;
      }

      if (document.activeElement === gotoInput) return;

      if (!e.ctrlKey && !e.metaKey && !e.altKey) {
        if (e.key === '+' || e.key === '=') {
          e.preventDefault();
          bumpViewScale(VIEW_SCALE_STEP);
          return;
        }
        if (e.key === '-' || e.key === '_') {
          e.preventDefault();
          bumpViewScale(1 / VIEW_SCALE_STEP);
          return;
        }
        if (e.key === '0' && gotoForm.hidden) {
          e.preventDefault();
          applyViewScale(defaultViewScale);
          return;
        }
      }

      /* Don't hijack keys aimed at interactive controls (footer buttons/goto
         form): Space must still activate a focused button. */
      if (e.target.closest('button, a, input, select, textarea, form')) return;

      if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ') {
        e.preventDefault(); goTo(idx + 1);
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault(); goTo(idx - 1);
      } else if (e.key === 'Home') {
        e.preventDefault(); goTo(0);
      } else if (e.key === 'End') {
        e.preventDefault(); goTo(slides.length - 1);
      }
    });

    // Re-fit on every signal that can change geometry (each entry maps to an
    // observed device failure — do not prune; see migrate_deck.py NAV_JS):
    // ResizeObserver on the clip, window resize, orientation (300ms settle),
    // visualViewport resize+scroll (pinch/toolbar layer), pageshow (bfcache),
    // fonts.ready (late metrics), and two delayed retries (toolbar settle).
    if (window.ResizeObserver) new ResizeObserver(fit).observe(clip);
    window.addEventListener('resize', fit);
    window.addEventListener('orientationchange', function() { setTimeout(fit, 300); });
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', fit);
      window.visualViewport.addEventListener('scroll', fit);
    }
    window.addEventListener('pageshow', fit);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
    setTimeout(fit, 500); setTimeout(fit, 1500);

    show(0);

    // Autofit is CONTENT-driven (the canvas is a fixed 1280x720), so it runs
    // on content signals — load, fonts, post-Mermaid — never per-resize.
    // Any slide whose content exceeds its box (either axis) is shrunk with
    // CSS `zoom` PAIRED WITH an inverse width/height, so the rendered box
    // stays exactly 1280x720 while the internal coordinate space grows —
    // text re-wraps to the wider space. Overflow is detected by comparing
    // scrollHeight/Width to clientHeight/Width (same coordinate space under
    // zoom — comparing against the 720 constant ratchets every slide to the
    // floor, because zoom rescales the element's internal coordinates).
    // Iterated because shrinking re-wraps and changes the measured size.
    // Runs over ALL slides — visibility:hidden preserves layout, so hidden
    // slides measure correctly (and the boundary audit sees every slide
    // post-fit). The 0.4 floor keeps a pathological slide legible: below it,
    // the section's overflow-y:auto scrolls instead of clipping.
    function autofitAll() {
      slides.forEach(function(s) {
        s.style.zoom = ''; s.style.width = ''; s.style.height = '';  // reset before measuring
        var z = 1, guard = 0;
        // Content painting into the section's padding band (e.g. past a
        // panel-shaped content area) never overflows the section box, so
        // also require the content area to contain its children.
        var ca = s.querySelector('.slide-content-area');
        function caRatio() {
          if (!ca || ca.scrollHeight <= ca.clientHeight + 1) return 1;
          return ca.clientHeight / ca.scrollHeight;
        }
        while ((s.scrollHeight > s.clientHeight + 1 || s.scrollWidth > s.clientWidth + 1
                || caRatio() < 1)
               && z > 0.4 && guard < 4) {
          z = Math.max(0.4, z * Math.min(s.clientHeight / s.scrollHeight,
                                         s.clientWidth / s.scrollWidth,
                                         caRatio()) * 0.98);  // 2% margin
          s.style.zoom = String(z);
          s.style.width = (CW / z) + 'px';        // inverse size: rendered box
          s.style.height = (CH / z) + 'px';       // stays exactly 1280x720
          guard++;
        }
      });
    }
    window.__mdToYamlAutofitAll = autofitAll;
    autofitAll();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(autofitAll);
    window.addEventListener('pageshow', autofitAll);

    // ---- slide-boundary audit -------------------------------------------
    // An element "crosses the boundary" when its VISIBLE box — its rect
    // intersected with every overflow-clipping ancestor up to the slide —
    // extends past the slide's rect. Content inside an overflow:auto
    // scroller is clipped by design and does not count. Used by the #debug
    // HUD and by the headless boundary test.
    function visibleRect(el, slide) {
      var r = el.getBoundingClientRect();
      var box = { left: r.left, top: r.top, right: r.right, bottom: r.bottom };
      for (var a = el.parentElement; a && a !== slide; a = a.parentElement) {
        var cs = getComputedStyle(a);
        if (/(auto|scroll|hidden|clip)/.test(cs.overflow + cs.overflowX + cs.overflowY)) {
          var ar = a.getBoundingClientRect();
          box.left = Math.max(box.left, ar.left);    box.top = Math.max(box.top, ar.top);
          box.right = Math.min(box.right, ar.right); box.bottom = Math.min(box.bottom, ar.bottom);
        }
      }
      return box;
    }
    function auditBounds(epsCanvasPx) {
      var scale = parseFloat(getComputedStyle(deckRoot).getPropertyValue('--deck-fit-scale')) || 1;
      var eps = (epsCanvasPx || 1.5) * scale;       // tolerate cross-engine glyph drift
      var out = [];
      slides.forEach(function(slide, i) {
        var sb = slide.getBoundingClientRect();
        slide.querySelectorAll('*').forEach(function(el) {
          var b = visibleRect(el, slide);
          if (b.right - b.left < 1 || b.bottom - b.top < 1) return;   // empty / display:none
          var over = Math.max(sb.left - b.left, sb.top - b.top,
                              b.right - sb.right, b.bottom - sb.bottom);
          if (over > eps) out.push({
            slide: i + 1,
            tag: el.tagName.toLowerCase(),
            cls: (el.getAttribute('class') || '').split(' ')[0],
            overflowCanvasPx: Math.round(over / scale * 10) / 10
          });
        });
      });
      return out;
    }
    window.__mdToYamlAuditBounds = auditBounds;
  })();
  </script>
  {% if has_mermaid %}
<script type="module">
{% if not bake_mermaid %}
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11.0/dist/mermaid.esm.min.mjs';

  // Mermaid v11: do not rely on Mermaid's fontSize being honored uniformly.
  // We render diagrams, then measure *actual* rendered label sizes and scale
  // the final SVG ourselves for slide readability.
  mermaid.initialize({
    startOnLoad: false,
    theme: '{{ mermaid_theme }}',

    // Set globally as well as per-diagram to defend against v11 defaults.
    useMaxWidth: false,
    fontSize: 22,
    fontFamily: "'{{ deck.metadata.font }}', sans-serif",

    // SVG-native <text> labels everywhere: the default foreignObject (HTML)
    // labels are mispositioned or invisible in WebKit when any ancestor
    // carries a CSS transform — and the fixed-canvas stage is exactly that.
    // SVG text also rasterizes crisper under transform than HTML-in-SVG.
    htmlLabels: false,
    flowchart: { useMaxWidth: false, htmlLabels: false },
    sequence: { useMaxWidth: false },
    timeline: { useMaxWidth: false },
    gantt:    { useMaxWidth: false },
    pie:      { useMaxWidth: false },
    journey:  { useMaxWidth: false },
    mindmap:  { useMaxWidth: false },
    quadrantChart: { useMaxWidth: false },

    themeVariables: {
      fontSize: '22px',
      fontFamily: "'{{ deck.metadata.font }}', sans-serif",
    },
  });
{% endif %}

  // Tag containers before Mermaid replaces the source nodes.
  document.querySelectorAll('.diagram-container pre.mermaid, .diagram-container .mermaid').forEach(pre => {
    const src = (pre.textContent || '').trim();
    let type = '';
    for (const raw of src.split('\n')) {
      const line = raw.trim();
      if (!line || line.startsWith('%%') || line.startsWith('---')) continue;
      type = line.split(/[\s:({]/)[0].toLowerCase();
      break;
    }
    const container = pre.closest('.diagram-container');
    if (container) {
      if (type) container.dataset.diagramType = type;
      // Store the diagram's title text so fixTimelineTitleCentering can find the
      // title element by content after mermaid.run() replaces the pre.
      const titleMatch = src.match(/^[ \t]*title[ \t]+(.+)$/im);
      if (titleMatch) container.dataset.diagramTitle = titleMatch[1].trim();
      container.classList.add('mermaid-pending');
      container.dataset.mermaidPre = '1';
    }
  });

  // Render only after fonts load so label widths are measured with the real
  // typeface, not a fallback (prevents box-sized-for-the-wrong-font misfits).
  if (document.fonts && document.fonts.ready) {
    try { await document.fonts.ready; } catch (e) {}
  }
{% if not bake_mermaid %}
  await mermaid.run();
  await new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));
{% endif %}

  async function waitForMermaidLayout() {
    if (document.fonts && document.fonts.ready) {
      try { await document.fonts.ready; } catch (e) {}
    }
    await new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));
  }
  await waitForMermaidLayout();


  const DEBUG_MERMAID_WAIT = false;
  function mermaidWaitLog(evt, data) {
    if (!DEBUG_MERMAID_WAIT) return;
    console.debug('mermaid-wait', { evt, ...data });
  }

  function countMermaidExpectedAndRendered() {
    const containers = Array.from(document.querySelectorAll('.diagram-container[data-mermaid-pre]'));
    let rendered = 0;
    for (const c of containers) {
      if (c.querySelector('svg')) rendered += 1;
    }
    return { expected: containers.length, rendered };
  }

  async function waitForAllMermaidSvgs(maxAttempts = 12) {
    for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
      const { expected, rendered } = countMermaidExpectedAndRendered();
      mermaidWaitLog('attempt-start', { attempt: `${attempt}/${maxAttempts}`, expected, rendered });

      if (expected > 0 && rendered >= expected) {
        mermaidWaitLog('attempt-end', { attempt: `${attempt}/${maxAttempts}`, ok: true, expected, rendered });
        return { ok: true, attempt, expected, rendered };
      }

      // Bounded backoff so late Mermaid diagram types don't miss the sizing pass.
      const ms = Math.min(250, 20 * attempt);
      await new Promise(r => setTimeout(r, ms));
      await new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));

      {
        const after = countMermaidExpectedAndRendered();
        mermaidWaitLog('attempt-end', {
          attempt: `${attempt}/${maxAttempts}`,
          ok: false,
          expected: after.expected,
          rendered: after.rendered,
        });
      }
    }
    const final = countMermaidExpectedAndRendered();
    mermaidWaitLog('done', { attempt: `12/12`, ok: false, ...final });
    return { ok: false, attempt: maxAttempts, ...final };
  }

  function markMermaidReadyFromSvg(svg) {
    const container = svg.closest('.diagram-container');
    if (!container) return;
    container.classList.remove('mermaid-pending');
    container.dataset.mermaidReady = '1';
  }

  await waitForAllMermaidSvgs();

  function median(values) {
    const a = values.filter(v => Number.isFinite(v) && v > 0).sort((x, y) => x - y);
    if (!a.length) return 0;
    const m = Math.floor(a.length / 2);
    return a.length % 2 ? a[m] : 0.5 * (a[m - 1] + a[m]);
  }

  function clamp(x, lo, hi) {
    return Math.max(lo, Math.min(hi, x));
  }


  function getScaleOverride(svg) {
    const container = svg.closest('.diagram-container');
    if (!container) return { mode: '', mult: 1 };

    const mode = String(container.dataset.scaleMode || '').trim().toLowerCase();
    let mult = parseFloat(container.dataset.scaleMult || '1');
    if (!Number.isFinite(mult) || mult <= 0) mult = 1;

    return { mode, mult };
  }

  function getSvgGeometry(svg) {
    const vb = svg.viewBox && svg.viewBox.baseVal;
    const vbW = (vb && vb.width > 0) ? vb.width : parseFloat(svg.getAttribute('width')) || 0;
    const vbH = (vb && vb.height > 0) ? vb.height : parseFloat(svg.getAttribute('height')) || 0;

    let contentW = vbW;
    let contentH = vbH;
    try {
      const bb = svg.getBBox();
      if (bb && bb.width > 0 && bb.height > 0) {
        contentW = bb.width;
        contentH = bb.height;
      }
    } catch (e) {
      // Fall back to viewBox.
    }

    return { vbW, vbH, contentW, contentH };
  }

  function measureRenderedLabelPx(svg) {
    const sizes = [];

    // 1) Standard SVG text labels
    svg.querySelectorAll('text').forEach(el => {
      try {
        const cs = getComputedStyle(el);
        const fs = parseFloat(cs.fontSize);
        if (fs > 0) {
          sizes.push(fs);
        } else {
          const bb = el.getBBox();
          if (bb && bb.height > 0) sizes.push(bb.height);
        }
      } catch (e) {}
    });

    // 2) Mermaid HTML labels inside foreignObject
    svg.querySelectorAll('foreignObject').forEach(fo => {
      fo.querySelectorAll('div, span, p, li').forEach(el => {
        try {
          const cs = getComputedStyle(el);
          const fs = parseFloat(cs.fontSize);
          if (fs > 0) {
            sizes.push(fs);
          } else {
            const r = el.getBoundingClientRect();
            if (r && r.height > 0) sizes.push(r.height);
          }
        } catch (e) {}
      });
    });

    return median(sizes);
  }

  function normalizeSvgForHostSizing(svg) {
    svg.removeAttribute('width');
    svg.removeAttribute('height');
    svg.removeAttribute('style');
    svg.style.display = 'block';
    svg.style.margin = '0 auto';
    svg.style.maxWidth = 'none';
    svg.style.maxHeight = 'none';
    svg.style.overflow = 'visible';
    svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
  }

  // Scale based on actual rendered label size, not Mermaid's requested font size.
  // minTextPx / maxTextPx are the *displayed* median label sizes you want on screen.
  function sizeSvgMeasured(svg, availW, availH, minTextPx = 28, maxTextPx = 42) {
    const { mode, mult } = getScaleOverride(svg);
    const container = svg.closest('.diagram-container');
    const isMindmap = (container && String(container.dataset.diagramType || '').toLowerCase() === 'mindmap');
    const isSequence = (container && String(container.dataset.diagramType || '').toLowerCase() === 'sequencediagram');
    normalizeSvgForHostSizing(svg);

    // Crop the SVG viewBox to its actual rendered content bbox.
    // Fixes pie chart: title text overflows the viewBox left edge → title is clipped.
    // Skip timeline: cropping the viewBox increases scale and causes the SVG to overflow
    // the card container. Timeline right-dead-space is handled by clipTimelineRightSpace().
    const _isTimeline = (container && String(container.dataset.diagramType || '').toLowerCase() === 'timeline');
    if (!_isTimeline) {
      try {
        const bb = svg.getBBox();
        if (bb && bb.width > 4 && bb.height > 4) {
          const pad = 6;
          svg.setAttribute('viewBox',
            `${bb.x - pad} ${bb.y - pad} ${bb.width + 2*pad} ${bb.height + 2*pad}`);
        }
      } catch(e) {}
    }

    if (availW <= 0 || availH <= 0) {
      svg.style.width = '100%';
      svg.style.height = 'auto';
      return { ok: false, reason: 'bad-available-space' };
    }

    const { vbW, vbH, contentW, contentH } = getSvgGeometry(svg);

    if (vbW <= 0 || vbH <= 0 || contentW <= 0 || contentH <= 0) {
      svg.style.width = availW + 'px';
      svg.style.height = 'auto';
      return { ok: false, reason: 'bad-svg-geometry' };
    }

    // Fit based on actual content bbox, but apply scale to the full viewBox so we do not crop.
    // Clamp denominators to at least vbW/vbH: when the viewBox is wider than the content bbox
    // (e.g. Mermaid timeline), vbW * fitScale would exceed availW without this clamp.
    const fitScale = Math.min(availW / Math.max(contentW, vbW), availH / Math.max(contentH, vbH));

    const measuredPx = measureRenderedLabelPx(svg);

    // Default to fit-to-box.
    let scale = fitScale;

    // Mermaid v11 mindmap: fontSize is not a reliable control signal across engines.
    // For mindmaps, prefer deterministic geometry-based scaling to fill the panel.
    if ((isMindmap || isSequence) && mode !== 'measured') {
      scale = Math.min(fitScale, fitScale * mult);
      svg.style.width = (vbW * scale) + 'px';
      svg.style.height = (vbH * scale) + 'px';
      return { ok: true, reason: (isMindmap ? 'mindmap-fit-panel' : 'sequence-fit-panel'), measuredPx, scale, fitScale, vbW, vbH, contentW, contentH };
    }

    if (mode === 'fit') {
      // Caller requested plain fit-to-panel (no readable-text target).
      scale = Math.min(fitScale, scale * mult);
      svg.style.width = (vbW * scale) + 'px';
      svg.style.height = (vbH * scale) + 'px';
      return { ok: true, reason: 'fit-only', measuredPx, scale, fitScale, vbW, vbH, contentW, contentH };
    }
    let ok = true;
    let reason = 'fit-only';

    if (measuredPx > 0) {
      const scaleForMin = minTextPx / measuredPx;
      const scaleForMax = maxTextPx / measuredPx;

      // If the diagram can satisfy the minimum readable text threshold without overflow, do it.
      if (fitScale >= scaleForMin) {
        scale = clamp(scaleForMin, 0.05, scaleForMax);
        scale = Math.min(scale, fitScale);
        reason = 'target-min-readable-text';
      } else {
        // Not enough room: fit as large as possible and record the failure.
        scale = fitScale;
        ok = false;
        reason = 'cannot-meet-min-text-within-panel';
      }
    } else {
      ok = false;
      reason = 'no-measurable-label-text';
    }

    // Author override (mermaid_scale): multiply the chosen scale, never past
    // the panel fit. >1 grows toward filling the panel; <1 widens the margin.
    if (mult !== 1) {
      scale = Math.min(scale * mult, fitScale);
      reason += '+mult';
    }

    svg.style.width = (vbW * scale) + 'px';
    svg.style.height = (vbH * scale) + 'px';

    return { ok, reason, measuredPx, scale, fitScale, vbW, vbH, contentW, contentH };
  }

  // Optional: useful while debugging Mermaid v11 behavior.
  const DEBUG_MERMAID_SIZING = false;
  function logSizing(svg, result, context) {
    if (!DEBUG_MERMAID_SIZING) return;
    const container = svg.closest('.diagram-container');
    console.log('Mermaid sizing', {
      context,
      type: container?.dataset?.diagramType || '',
      role: svg.getAttribute('aria-roledescription') || '',
      ...result
    });
  }

  // Scoped to Mermaid-generated SVGs. We select by [data-mermaid-pre] rather
  // than svg[id^="mermaid"] because Mermaid v11 uses different id schemes by type.
  const SLIDE_PAD   = 96;  // 96px (1in at 96dpi) slide edge
  const PANEL_INSET = 48;  // panel internal padding (combined horizontal/vertical slack)
  const PANEL_FILL = 0.95; // max fraction of its panel a Mermaid diagram may occupy
  // Diagrams live inside the fixed 1280x720 stage — available space is canvas
  // space, never the live window.
  const CANVAS_W = 1280, CANVAS_H = 720;
  // getBoundingClientRect returns viewport px, scaled by the stage transform;
  // divide by the current fit scale to express a measurement in canvas px.
  function deckFitScale() {
    // Derive the applied scale from the stage's rendered rect rather than the
    // --deck-fit-scale var: the rect reflects the transform that is actually
    // in effect at call time, immune to var-propagation timing.
    const root = document.getElementById('deck-app-root');
    const w = root ? root.getBoundingClientRect().width : 0;
    return (Number.isFinite(w) && w > 0) ? (w / CANVAS_W) : 1;
  }
  // Effective rendered scale of an element = fit transform x per-slide autofit
  // zoom. Autofit pairs zoom with an inverse width/height, so the slide's own
  // rect stays 1280x720 and cannot reveal the zoom — but any inner block can:
  // offset sizes are in the slide's internal (layout) px while the rect is
  // visual px. Sizing an SVG in internal px is correct because its inline
  // width/height resolve in that same coordinate space.
  function elScale(el) {
    const probe = (el && el.offsetWidth) ? el : (el && el.parentElement);
    if (!probe || !probe.offsetWidth) return deckFitScale();
    return probe.getBoundingClientRect().width / probe.offsetWidth;
  }
  function canvasRectH(el) { return el.getBoundingClientRect().height / elScale(el); }
  function canvasRectW(el) { return el.getBoundingClientRect().width / elScale(el); }

  function sizeAllMermaidSvgs() {
    // Sizing must run at autofit zoom 1. Autofit pairs zoom with an inverse
    // box, inflating the slide's internal coordinate space — a panel measured
    // in that space yields an svg that stays too wide once a later autofit
    // pass resets the zoom (the panel's overflow then clips it). Reset all
    // slides, size against true geometry, then re-run autofit at the end so
    // it gets the final say with the final svg sizes.
    document.querySelectorAll('section[role="group"]').forEach(s => {
      s.style.zoom = ''; s.style.width = ''; s.style.height = '';
    });
    // Full-slide diagrams: the panel (.diagram-container) is flex:1, so its
    // box is fixed by the layout (title and caption already carved out).
    // Measure it directly minus its own padding — canvas-constant arithmetic
    // over-subtracts and strands panel space as margin.
    document.querySelectorAll('.slide-diagram .diagram-container[data-mermaid-pre] svg').forEach(svg => {
      const panel = svg.closest('.diagram-container');

      const availW = canvasRectW(panel) * PANEL_FILL;
      const availH = canvasRectH(panel) * PANEL_FILL;

      const result = sizeSvgMeasured(svg, availW, availH, 34, 54);
      logSizing(svg, result, 'slide-diagram');
      markMermaidReadyFromSvg(svg);
    });

    // Two-column diagrams: the panel (.diagram-container) fills the column
    // band (flex-basis 100%, scaled by --panel-scale-x/y), so its box is
    // fixed by the layout — measure it directly, like slide-diagram above.
    // Measuring the column instead would ignore panel_scale and overrun a
    // shrunken panel.
    document.querySelectorAll('.slide-two-column .diagram-container[data-mermaid-pre] svg').forEach(svg => {
      const container = svg.closest('.diagram-container');

      const availW = canvasRectW(container) * PANEL_FILL;
      const availH = canvasRectH(container) * PANEL_FILL;

      const result = sizeSvgMeasured(svg, availW, availH, 30, 46);
      logSizing(svg, result, 'slide-two-column');
      markMermaidReadyFromSvg(svg);
    });

    // Figure layout
    const FIG_WRAP_INSET = 80;
    const FIG_V_PAD = 48;
    document.querySelectorAll('.slide-figure .figure-asset .diagram-container[data-mermaid-pre] svg').forEach(svg => {
      const section = svg.closest('section.slide-figure');
      if (!section) return;

      const isOnly = section.classList.contains('figure-only');
      const wFrac = isOnly ? 0.95 : 0.88;
      const vhFrac = isOnly ? 0.78 : 0.72;
      const raw = (getComputedStyle(section).getPropertyValue('--figure-scale') || '1').trim();
      const fscale = Math.max(0.25, Math.min(4, parseFloat(raw) || 1));

      const titleBlock = section.querySelector('header.slide-heading-stack') || section.querySelector('h2');
      const titleH = titleBlock ? canvasRectH(titleBlock) : 60;

      // Available space below the title, in canvas px: slides are fixed
      // 1280x720 layers — never measure the live window.
      const maxBelowTitle = CANVAS_H - (2 * SLIDE_PAD) - titleH;

      const cw = CANVAS_W - 2 * SLIDE_PAD;
      const maxWrapW = Math.min(cw, cw * wFrac * fscale);
      const availW = Math.max(40, maxWrapW - FIG_WRAP_INSET);

      const fromVh = CANVAS_H * vhFrac * fscale;
      const availH = Math.max(60, Math.min(fromVh, maxBelowTitle) - FIG_V_PAD);

      const result = sizeSvgMeasured(svg, availW, availH, 34, 54);
      logSizing(svg, result, 'slide-figure');
      markMermaidReadyFromSvg(svg);
    });

    // Figure-wide
    const FW_INSET = 40;
    document.querySelectorAll('.slide-figure-wide .figure-wide-figure-wrap .diagram-container[data-mermaid-pre] svg').forEach(svg => {
      const wrap = svg.closest('.figure-wide-figure-wrap');
      if (!wrap) return;

      const bW = canvasRectW(wrap), bH = canvasRectH(wrap);
      const fig = svg.closest('.figure-wide-figure');
      const cap = fig && fig.querySelector('figcaption');
      const capH = (cap && canvasRectH(cap)) || 0;
      const gap = cap ? 12 : 0;

      const availW = Math.max(40, bW - FW_INSET);
      const availH = Math.max(60, bH - FW_INSET - capH - gap);

      const result = sizeSvgMeasured(svg, availW, availH, 30, 46);
      logSizing(svg, result, 'slide-figure-wide');
      markMermaidReadyFromSvg(svg);
    });

    // Autofit gets the final say, now that every svg has its final size.
    if (window.__mdToYamlAutofitAll) window.__mdToYamlAutofitAll();
  }

  // Expose for view-scale changes (Shift++ / footer controls) so Mermaid SVGs
  // can be re-sized when the deck zoom changes.
  window.__mdToYamlSizeAllMermaidSvgs = sizeAllMermaidSvgs;

  // Fix Mermaid v11 timeline title centering. The timeline renderer places the title
  // at x = totalSvgWidth/2, but the SVG viewBox includes extra space to the right for
  // the arrow extension, so the title lands right of visual center. getBBox() cannot
  // fix this via viewBox crop because timeline boxes are foreignObject elements (excluded
  // from getBBox). Instead, after layout settles, measure the actual content bounds via
  // getBoundingClientRect (which includes foreignObjects), compute the visual center in
  // SVG coordinate space, and reposition the .titleText element.
  function fixTimelineTitleCentering() {
    document.querySelectorAll('.diagram-container[data-diagram-type="timeline"] svg').forEach(svg => {
      const svgRect = svg.getBoundingClientRect();
      if (!svgRect || svgRect.width < 2) return;
      const vb = svg.viewBox && svg.viewBox.baseVal;
      if (!vb || vb.width < 2) return;

      // Measure visual content bounds via screen coords — getBoundingClientRect
      // includes foreignObject and path elements (period/event boxes) unlike getBBox.
      let minX = Infinity, maxX = -Infinity;
      svg.querySelectorAll('foreignObject, rect, path').forEach(el => {
        const r = el.getBoundingClientRect();
        if (r.width > 4) {
          minX = Math.min(minX, r.left);
          maxX = Math.max(maxX, r.right);
        }
      });
      if (!isFinite(minX) || maxX <= minX) return;

      const scaleX = vb.width / svgRect.width;
      const centerSVG = vb.x + ((minX + maxX) / 2 - svgRect.left) * scaleX;

      // Locate the title text element using stored title text (most reliable),
      // then CSS class, then fall back to the topmost <text> by y-coordinate.
      const container = svg.closest('.diagram-container');
      const storedTitle = (container && container.dataset.diagramTitle) || '';
      const allText = Array.from(svg.querySelectorAll('text'));
      const titleEl = (storedTitle
        ? allText.find(t => (t.textContent || '').trim() === storedTitle)
        : null)
        || svg.querySelector('.titleText')
        || svg.querySelector('text[class*="title"]')
        || (allText.length
          ? allText.reduce((top, t) =>
              parseFloat(t.getAttribute('y') || '9999') < parseFloat(top.getAttribute('y') || '9999')
                ? t : top)
          : null);

      if (!titleEl) return;
      // Clamp so the title doesn't overflow the SVG viewBox left/right edges.
      const titleWidth = titleEl.getComputedTextLength ? titleEl.getComputedTextLength() : 0;
      const halfW = titleWidth / 2;
      const pad = 5;
      let x = centerSVG;
      if (x - halfW < vb.x + pad) x = vb.x + pad + halfW;
      if (x + halfW > vb.x + vb.width - pad) x = vb.x + vb.width - pad - halfW;
      titleEl.setAttribute('x', x);
      titleEl.setAttribute('text-anchor', 'middle');
    });
  }

  // Clip the dead space to the right of the arrow in Mermaid timeline SVGs.
  // Mermaid allocates extra viewBox width past the arrow tip, leaving blank space.
  // We clip the .diagram-container to the arrow right edge rather than changing the SVG
  // viewBox (which alters the scale) or SVG width (which shrinks content via aspect ratio).
  function clipTimelineRightSpace() {
    document.querySelectorAll('.diagram-container[data-diagram-type="timeline"]').forEach(container => {
      const svg = container.querySelector('svg');
      if (!svg) return;
      const svgRect = svg.getBoundingClientRect();
      if (!svgRect || svgRect.width < 2) return;

      // Find the rightmost horizontal line (the timeline arrow baseline).
      let arrowRight = -Infinity;
      svg.querySelectorAll('line').forEach(el => {
        const r = el.getBoundingClientRect();
        if (r.width > 20) arrowRight = Math.max(arrowRight, r.right);
      });
      if (!isFinite(arrowRight) || arrowRight <= svgRect.left) return;

      // Clip the container width to just past the arrow tip (+12px padding).
      // Rect deltas are viewport px (scaled by the stage transform) — convert
      // to canvas px before assigning a layout width.
      const s = deckFitScale();
      const clipW = (arrowRight - svgRect.left) / s + 12;
      if (clipW < svgRect.width / s - 5) {
        container.style.width = clipW + 'px';
        container.style.overflow = 'hidden';
      }
    });
  }

  sizeAllMermaidSvgs();
  // Diagrams change slide heights — re-run the controller's per-slide autofit.
  if (window.__mdToYamlAutofitAll) window.__mdToYamlAutofitAll();

  // Re-run after late layout stabilization and on resize.
  setTimeout(sizeAllMermaidSvgs, 150);
  setTimeout(sizeAllMermaidSvgs, 600);
  setTimeout(sizeAllMermaidSvgs, 1500);
  setTimeout(() => window.__mdToYamlAutofitAll && window.__mdToYamlAutofitAll(), 1600);
  // Timeline title fix and clip run after sizing has settled and browser has redrawn.
  setTimeout(fixTimelineTitleCentering, 250);
  setTimeout(clipTimelineRightSpace, 300);
  setTimeout(fixTimelineTitleCentering, 750);
  setTimeout(clipTimelineRightSpace, 800);
  setTimeout(fixTimelineTitleCentering, 1600);
  setTimeout(clipTimelineRightSpace, 1650);
  window.addEventListener('resize', () => {
    clearTimeout(window.__mermaidResizeTimer);
    window.__mermaidResizeTimer = setTimeout(sizeAllMermaidSvgs, 80);
    clearTimeout(window.__timelineTitleTimer);
    window.__timelineTitleTimer = setTimeout(() => {
      fixTimelineTitleCentering();
      clipTimelineRightSpace();
    }, 160);
  });


</script>
{% endif %}

</body>
</html>
