<!DOCTYPE html>
<html lang="en" data-theme="{{ deck.metadata.theme }}" data-deck-default-view-scale="{{ deck.metadata.view_scale }}" data-deck-remember-view-scale="{{ 'true' if deck.metadata.remember_view_scale else 'false' }}" data-deck-figure-layout-debug="{{ 'true' if figure_layout_debug else 'false' }}" style="--footer-scale: {{ deck.metadata.footer_scale }}; --slide-footer-inset: {{ deck.metadata.footer_inset | e }};">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {# MathML namespace URI (declared once here; <math> nodes omit redundant xmlns) #}
  <meta name="mathml-namespace-uri" content="http://www.w3.org/1998/Math/MathML">
  <title>{{ deck.metadata.title | e }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family={{ deck.metadata.font | replace(' ', '+') }}:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      /* Fixed deck canvas (16:9): all px below are authored against 1280x720. */
      --deck-canvas-w: 1280;
      --deck-canvas-h: 720;
      /* Baseline zoom; per-slide --title-scale / --content-scale set on each section. */
      --font-scale: 1.35;
      /* Fixed footer: deck metadata `footer_scale` / `footer_inset` on <html> override these. */
      --footer-scale: 1;
      --slide-footer-inset: 48px;
      /* clear fixed .slide-footer-nav (z-index) — figure slides only adjust bottom padding. */
      --slide-footer-ui-clearance: calc(2.75rem * var(--footer-scale, 1));
    }

    :root[data-theme="dark"] {
      --bg: #0d1117;
      --bg2: #161b22;
      --text: #e6edf3;
      --muted: #8b949e;
      --accent: {% if deck.metadata.accent_color %}{{ deck.metadata.accent_color }}{% else %}#f0a500{% endif %};
      --border: #30363d;
      --slide-frame: #4a5568;      /* slide outer border — visible on dark bg; override in YAML via accent_color */
      --font-family: '{{ deck.metadata.font }}', sans-serif;
      --fig-panel: #1e2330;        /* figure panel bg — contrast vs #e6edf3 text ≥ 9:1 (WCAG AA) */
      --fig-panel-border: #2d3548;
      --two-col-title-gap: 48px;           /* gap between slide title and two-column content area */
      --two-col-fig-max-height: 100%;       /* image height cap in two-col (single figure). 100% = fill column; use e.g. 561.6px to cap */
      --two-col-both-fig-max-height: 100%;  /* image height cap when both columns have figures */
    }

    :root[data-theme="light"] {
      --bg: #ffffff;
      --bg2: #f6f8fa;
      --text: #1f2328;
      --muted: #656d76;
      --slide-frame: #a0aab4;      /* slide outer border — visible on light bg */
      --fig-panel: #eef1f5;        /* figure panel bg — contrast vs #1f2328 text ≥ 11:1 (WCAG AA) */
      --fig-panel-border: #d0d7de;
      --accent: {% if deck.metadata.accent_color %}{{ deck.metadata.accent_color }}{% else %}#b06800{% endif %};
      --border: #d1d9e0;
      --font-family: '{{ deck.metadata.font }}', sans-serif;
    }

    html, body {
      height: 100%;
      overflow: hidden;
      overscroll-behavior: none;
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-family);
    }

    .skip-link {
      position: absolute;
      left: -9999px;
      top: 0;
      z-index: 1000;
      background: var(--accent);
      color: var(--bg);
      padding: 0.5rem 1rem;
    }
    .skip-link:focus { left: 0; }

    /* Fixed 1280x720 stage. Center is pinned to the clip's center by arithmetic
       (50% offset minus half the fixed size); the JS-computed --deck-fit-scale
       scales it about that center. No grid/flex alignment ever touches this
       oversized box — cross-engine alignment of overflowing boxes is exactly
       where retrofit attempts broke. Footer nav stays a SIBLING of this stage
       so its position:fixed is never re-anchored by the transform. */
    #deck-app-root {
      position: absolute;
      left: 50%; top: 50%;
      margin: -360px 0 0 -640px;            /* -H/2, -W/2 */
      width: 1280px; height: 720px;
      transform-origin: 50% 50%;
      transform: scale(var(--deck-fit-scale, 1));
      overflow: hidden;
    }

    /* Bottom-centered counter + go-to + view scale (fixed; 96px margin band). */
    .slide-footer-nav {
      position: fixed;
      bottom: var(--slide-footer-inset, 48px);
      left: 50%;
      transform: translateX(-50%);
      z-index: 100;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: calc(0.5rem * var(--footer-scale, 1));
      font-size: calc(0.875rem * var(--footer-scale, 1));
      color: var(--muted);
      padding: calc(0.2rem * var(--footer-scale, 1)) calc(0.55rem * var(--footer-scale, 1)) calc(0.25rem * var(--footer-scale, 1)) calc(0.55rem * var(--footer-scale, 1));
      border-radius: calc(8px * var(--footer-scale, 1));
      background: color-mix(in srgb, var(--bg) 88%, transparent);
      border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
      box-shadow: 0 1px 8px color-mix(in srgb, var(--bg) 40%, #000 60%);
      backdrop-filter: blur(6px);
    }

    #slide-counter {
      font: inherit;
      font-size: calc(0.9rem * var(--footer-scale, 1));
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
      user-select: none;
    }

    .slide-goto-open {
      font: inherit;
      font-size: calc(0.8rem * var(--footer-scale, 1));
      font-weight: 600;
      line-height: 1;
      padding: calc(0.2rem * var(--footer-scale, 1)) calc(0.45rem * var(--footer-scale, 1));
      color: var(--accent);
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 4px;
      cursor: pointer;
    }

    .slide-goto-open:hover,
    .slide-goto-open:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 1px;
    }

    .deck-view-scale-cluster {
      display: inline-flex;
      align-items: center;
      gap: calc(0.25rem * var(--footer-scale, 1));
      padding-right: calc(0.45rem * var(--footer-scale, 1));
      margin-right: calc(0.35rem * var(--footer-scale, 1));
      border-right: 1px solid color-mix(in srgb, var(--border) 65%, transparent);
    }

    .deck-view-scale-btn {
      font: inherit;
      font-size: calc(0.95rem * var(--footer-scale, 1));
      font-weight: 700;
      line-height: 1;
      min-width: calc(1.65rem * var(--footer-scale, 1));
      padding: calc(0.15rem * var(--footer-scale, 1)) calc(0.35rem * var(--footer-scale, 1));
      color: var(--text);
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 4px;
      cursor: pointer;
    }

    .deck-view-scale-btn:hover,
    .deck-view-scale-btn:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 1px;
    }

    #deck-view-scale-pct {
      font-variant-numeric: tabular-nums;
      font-size: calc(0.78rem * var(--footer-scale, 1));
      color: var(--muted);
      min-width: calc(2.75rem * var(--footer-scale, 1));
      text-align: center;
      user-select: none;
    }

    .slide-goto-form {
      display: flex;
      align-items: center;
      gap: calc(0.35rem * var(--footer-scale, 1));
      margin: 0;
    }

    .slide-goto-form[hidden] {
      display: none !important;
    }

    .slide-goto-input {
      width: 4.5ch;
      min-width: calc(3rem * var(--footer-scale, 1));
      max-width: 6rem;
      font: inherit;
      font-size: calc(0.875rem * var(--footer-scale, 1));
      font-variant-numeric: tabular-nums;
      color: var(--text);
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: calc(0.15rem * var(--footer-scale, 1)) calc(0.35rem * var(--footer-scale, 1));
    }

    .slide-goto-input:focus {
      outline: 2px solid var(--accent);
      outline-offset: 1px;
    }

    /* #debug HUD (append #debug to the URL): overlays the geometry numbers
       the browser reports, so misbehavior on a device reports exact figures. */
    #deck-hud {
      display: none;
      position: fixed; top: 8px; left: 8px; z-index: 999;
      font: 12px/1.5 monospace; color: #0f0; background: rgba(0,0,0,.8);
      padding: 8px 10px; border-radius: 6px; white-space: pre; pointer-events: none;
    }

    /* The clip: always the full viewport; the stage scales inside it. */
    main#main-content {
      position: fixed; inset: 0;
      overflow: hidden;
      background: var(--bg);
    }

    section[role="group"] {
      /* Explicit box, not inset:0 — autofit pairs CSS zoom with an inverse
         width/height so the rendered box stays exactly 1280x720; inset-based
         sizing under zoom is engine-quirky (Chrome collapses the box). */
      position: absolute; left: 0; top: 0;
      width: 1280px; height: 720px;
      display: flex;
      flex-direction: column;
      padding: 96px;
      border: 2px solid var(--slide-frame);
      --title-font-mul: calc(var(--font-scale) * var(--title-scale));
      --content-font-mul: calc(var(--font-scale) * var(--content-scale));
      visibility: hidden;           /* keeps layout: Mermaid/MathML can measure */
      overflow-y: auto;             /* safety valve if a slide overflows 720px */
    }
    section[role="group"].active { visibility: visible; }
    /* show() moves programmatic focus to the slide for SR announcements; the
       default focus ring would outline every slide. Keyboard users navigate
       with arrows (not Tab), so no visible ring is lost. */
    section[role="group"]:focus { outline: none; }
    /* Title and divider slides: centered (presentation default) */
    section[role="group"].slide-title,
    section[role="group"].slide-divider {
      justify-content: center;
    }
    .slide-content-area {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    /* Math (MathML) inside headings — "inline math" keeps MathML inline-flow;
       plain "inline" is ignored by Chromium's MathML layout engine. */
    h1 math, h2 math, h3 math {
      display: inline math;
      font-size: inherit;
    }
    /* Override text-wrap: balance for headings with math to prevent fragments from stacking */
    h1:has(math), h2:has(math), h3:has(math) {
      text-wrap: wrap;
    }
    /* Class-based fallback when :has() is unsupported or balance still wins (see engine title_has_math) */
    section.slide-heading-math h1,
    section.slide-heading-math h2,
    section.slide-heading-math h3 {
      text-wrap: wrap !important;
    }
    section.slide-heading-math h1 math,
    section.slide-heading-math h2 math,
    section.slide-heading-math h3 math {
      display: inline math !important;
      vertical-align: baseline;
    }

    /* Title slide (h1) — ADA projection scale */
    h1 {
      font-size: calc(96px * var(--title-font-mul));
      font-weight: 700;
      line-height: 1.0;
      text-wrap: balance;
      margin-bottom: 1rem;
      text-align: center;
      color: var(--text);
    }
    /* h1/h2 + optional subtitle: stack font-size is the title; subtitle is 80% */
    .slide-heading-stack {
      text-align: center;
      margin-bottom: 1rem;
    }
    .slide-heading-stack--title {
      font-size: calc(96px * var(--title-font-mul));
      margin-bottom: 1rem;
    }
    .slide-heading-stack--title h1 {
      font-size: 1em;
      margin-bottom: 0;
    }
    .slide-heading-stack--title .slide-subtitle {
      font-size: 0.8em;
      font-weight: 500;
      line-height: 1.25;
      text-align: center;
      color: var(--muted);
      margin-top: 0.35em;
      margin-bottom: 0;
      text-wrap: balance;
    }
    .slide-heading-stack--standard {
      font-size: calc(52px * var(--title-font-mul));
    }
    .slide-heading-stack--standard h2 {
      font-size: 1em;
      margin-bottom: 0;
    }
    .slide-heading-stack--standard .slide-subtitle {
      font-size: 0.8em;
      font-weight: 500;
      line-height: 1.25;
      text-align: center;
      color: var(--muted);
      margin-top: 0.35em;
      margin-bottom: 0;
      text-wrap: balance;
    }
    .slide-heading-stack--divider {
      font-size: calc(80px * var(--title-font-mul));
    }
    .slide-heading-stack--divider h2 {
      font-size: 1em;
      margin-bottom: 0;
    }
    .slide-heading-stack--divider .slide-subtitle {
      font-size: 0.8em;
      font-weight: 500;
      line-height: 1.25;
      text-align: center;
      color: var(--muted);
      margin-top: 0.35em;
      margin-bottom: 0;
      text-wrap: balance;
    }
    .slide-quote-block {
      font-size: calc(44px * var(--title-font-mul));
    }
    section.slide-quote .slide-quote-block blockquote {
      font-size: 1em;
    }
    section.slide-quote .slide-quote-block .slide-subtitle {
      font-size: 0.8em;
      font-style: normal;
      font-weight: 500;
      line-height: 1.25;
      color: var(--muted);
      margin-top: 0.5em;
      text-wrap: balance;
    }
    .slide-title .author {
      font-size: calc(28px * var(--content-font-mul));
      text-align: center;
      color: var(--muted);
    }

    h2 {
      font-size: calc(52px * var(--title-font-mul));
      font-weight: 700;
      line-height: 1.1;
      text-wrap: balance;
      margin-bottom: 1rem;
      color: var(--accent);
      text-align: center;
    }

    /* **$...$** / **text $x$** in YAML: accent like h2; plain text in span needs color too */
    .deck-math-emphasis {
      color: var(--accent);
      font-weight: 700;
    }
    .deck-math-emphasis math,
    .deck-math-emphasis math * {
      color: var(--accent);
    }
    h3 {
      font-size: calc(34px * var(--title-font-mul));
      font-weight: 600;
      margin-bottom: 0.5rem;
    }
    .slide-body {
      font-size: calc(28px * var(--content-font-mul));
      line-height: 1.6;
      text-align: left;
    }
    .slide-body ul,
    .slide-body ol { padding-left: 2rem; }
    .slide-body ol { padding-left: 2.5rem; }
    .slide-body ol li { padding-left: 0.5rem; }
    .slide-body li { margin-bottom: 0.75em; }
    /* Nested lists: space after the parent line matches gap between top-level bullets */
    .slide-body li > ul,
    .slide-body li > ol {
      margin-top: 0.75em;
    }

    /* Display equations ($$...$$): scale via --math-display-scale; center vs start via section class */
    .slide-body math[display="block"],
    .hero-body math[display="block"],
    .hero-description math[display="block"] {
      display: block;
      font-size: calc(1em * var(--math-display-scale, 1));
      margin: 0.85em 0;
      text-align: start;
      color: var(--math-display-color, inherit);
    }
    /* Table slides: block math in cells (not .slide-body) still get display-math color */
    section.slide-table td math[display="block"],
    section.slide-table th math[display="block"] {
      color: var(--math-display-color, inherit);
    }
    section.math-display-eq-center .slide-body math[display="block"],
    section.math-display-eq-center .hero-body math[display="block"],
    section.math-display-eq-center .hero-description math[display="block"] {
      /* Without an intrinsic width, block <math> fills the line and
         margin:auto does not move the visual formula (Markdown often emits
         bare <math> between <p> blocks, so the p:flex rule does not run). */
      width: fit-content;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }
    section.math-display-eq-start .slide-body math[display="block"],
    section.math-display-eq-start .hero-body math[display="block"],
    section.math-display-eq-start .hero-description math[display="block"] {
      margin-left: 0;
      margin-right: 0;
      text-align: start;
    }
    .slide-body p:has(> math[display="block"]:only-child),
    .hero-body p:has(> math[display="block"]:only-child),
    .hero-description p:has(> math[display="block"]:only-child) {
      margin: 0;
    }
    /* Flex centers block MathML reliably (margin:auto on <math> is inconsistent across UAs). */
    section.math-display-eq-center .slide-body p:has(> math[display="block"]:only-child),
    section.math-display-eq-center .hero-body p:has(> math[display="block"]:only-child),
    section.math-display-eq-center .hero-description p:has(> math[display="block"]:only-child) {
      display: flex;
      justify-content: center;
      width: 100%;
      box-sizing: border-box;
      text-align: center;
    }
    section.math-display-eq-start .slide-body p:has(> math[display="block"]:only-child),
    section.math-display-eq-start .hero-body p:has(> math[display="block"]:only-child),
    section.math-display-eq-start .hero-description p:has(> math[display="block"]:only-child) {
      display: block;
      text-align: start;
    }
    /* Table slides: no .slide-body wrapper; center display math in cells when requested */
    section.math-display-eq-center.slide-table td math[display="block"],
    section.math-display-eq-center.slide-table th math[display="block"] {
      display: block;
      width: fit-content;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }
    section.math-display-eq-center.slide-table td:has(> math[display="block"]:only-child),
    section.math-display-eq-center.slide-table th:has(> math[display="block"]:only-child) {
      text-align: center;
      vertical-align: middle;
    }
    /* Transcript table: beat cell text-align:left from theme rules */
    main.deck-flavor-transcript section.slide-table.math-display-eq-center td:has(> math[display="block"]:only-child),
    main.deck-flavor-transcript section.slide-table.math-display-eq-center th:has(> math[display="block"]:only-child) {
      text-align: center;
    }

    /* Markdown tables in body */
    .slide-body table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      margin: 1.5rem 0;
    }
    .slide-body th,
    .slide-body td {
      padding: 0.65em 1.4em;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }
    .slide-body th {
      color: var(--accent);
      font-weight: 700;
      border-bottom: 2px solid var(--border);
    }
    .slide-body tr:last-child td { border-bottom: none; }
    .slide-body td:first-child { color: var(--accent); font-weight: 700; }
    .slide-body th:not(:last-child),
    .slide-body td:not(:last-child) { padding-right: 2.5em; }

    /* Markdown **bold** in body: same accent as h2 (not only **$x$** / **text $x$** spans) */
    .slide-body strong {
      color: var(--accent);
      font-weight: 700;
    }

    .hero-description {
      font-size: calc(34px * var(--title-font-mul));
      color: var(--muted);
      text-align: center;
    }
    .hero-body {
      font-size: calc(30px * var(--title-font-mul));
      color: var(--muted);
      text-align: center;
      max-width: 50em;
      margin: 1rem auto 0;
      line-height: 1.6;
    }

    figcaption {
      font-size: calc(23.04px * var(--content-font-mul));
      color: var(--muted);
      margin-top: 0.75rem;
    }

    .two-col {
      display: grid;
      gap: 2rem;
      align-items: stretch;
      min-height: 0;
      height: 100%;
    }
    .two-col-50-50 { grid-template-columns: 1fr 1fr; }
    .two-col-40-60 { grid-template-columns: 2fr 3fr; }
    .two-col-60-40 { grid-template-columns: 3fr 2fr; }
    /* Columns fill the grid cell; image/body centered within */
    .two-col > .col-left,
    .two-col > .col-right {
      min-height: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    /* Two-column slides clip hard so the figure's max-height:100% cascade
       resolves against the fixed 720px layer (inset:0 supplies the height). */
    section[role="group"].slide-two-column,
    section[role="group"].slide-comparison {
      overflow: hidden;
    }
    /* Reserve a gap below the title so the figure never encroaches on it */
    .slide-two-column .slide-content-area,
    .slide-comparison .slide-content-area {
      min-height: 0;
      margin-top: var(--two-col-title-gap);
    }
    /* Text split in two columns: start under title (avoid vertical centering gap) */
    section.slide-two-column .slide-content-area:has(.two-col--markdown-split) {
      justify-content: flex-start;
      margin-top: 144px;
    }
    section.slide-two-column .two-col--markdown-split > .col-left,
    section.slide-two-column .two-col--markdown-split > .col-right {
      justify-content: flex-start;
    }
    /* Comparison: the content area is the panel (same chrome as figure
       slides) — it spans title-to-bottom-margin, and each column centers
       its content on the panel's geometry. */
    section.slide-comparison .slide-content-area {
      background: var(--fig-panel);
      border: 1px solid var(--fig-panel-border);
      border-radius: 10px;
      padding: 16px 32px;
    }
    section.slide-comparison .two-col > .col-left,
    section.slide-comparison .two-col > .col-right {
      justify-content: center;
    }
    /* Heading-to-list: .slide-body must be flex for gap to apply (col-* only has one child). */
    section.slide-two-column .two-col--markdown-split > .col-left.slide-body,
    section.slide-two-column .two-col--markdown-split > .col-right.slide-body,
    section.slide-comparison .two-col > .col-left.slide-body,
    section.slide-comparison .two-col > .col-right.slide-body {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      gap: calc(1.35rem * 1.5 * 1.5);
    }
    /* In-panel column headings follow content scale (the slide h2 alone
       follows title scale) so content_scale resizes the whole panel uniformly. */
    section.slide-two-column .two-col--markdown-split .slide-body > h3,
    section.slide-comparison .two-col .slide-body > h3 {
      font-size: calc(34px * var(--content-font-mul) * 1.2);
      margin-bottom: 0;
    }
    section.slide-two-column .two-col--markdown-split .slide-body > ul,
    section.slide-comparison .two-col .slide-body > ul {
      margin-top: 0;
    }

    /* Flex item min-height:auto would prevent shrinking — images need min-height:0 to honor max-height:100% */
    .two-col img { min-height: 0; flex-shrink: 1; }
    /* Comparison slide: first bold line in each column is the column heading */
    section.slide-comparison .two-col-50-50 > .slide-body > p:first-of-type {
      margin-bottom: 1rem;
    }
    section.slide-comparison .two-col-50-50 > .slide-body > p:first-of-type strong {
      font-size: calc(36px * var(--content-font-mul));
      font-weight: 700;
      color: var(--accent);
      line-height: 1.25;
      display: block;
    }
